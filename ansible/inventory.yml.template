all:
  children:
    database_master:
      hosts:
        db_master:
          ansible_host: {{ DB_MASTER }}
          internal_ip: {{ DB_MASTER_INTERNAL_IP }}
          #ansible_ssh_common_args: '-o ProxyJump=ubuntu@{{ LB_EXT }}'
    database_replica:
      hosts:
        db_replica:
          ansible_host: {{ DB_REPLICA }}
          internal_ip: {{ DB_REPLICA_INTERNAL_IP }}
          #ansible_ssh_common_args: '-o ProxyJump=ubuntu@{{ LB_EXT }}'
    app_servers:
      hosts:
        app1:
          ansible_host: {{ APP1 }}
          internal_ip: {{ APP1_INTERNAL_IP }}
          #ansible_ssh_common_args: '-o ProxyJump=ubuntu@{{ LB_EXT }}'
        app2:
          ansible_host: {{ APP2 }}
          internal_ip: {{ APP2_INTERNAL_IP }}
          #ansible_ssh_common_args: '-o ProxyJump=ubuntu@{{ LB_EXT }}'
    load_balancers:
      hosts:
        lb:
          ansible_host: {{ LB_EXT }}
          internal_ip: {{ LB_INT }}
    monitoring:
      hosts:
        zbx_server:
          ansible_host: {{ LB_EXT }}
          internal_ip: {{ LB_INT }}