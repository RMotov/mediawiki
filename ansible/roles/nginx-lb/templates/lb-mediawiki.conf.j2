upstream backend_mediawiki {
    # Список app серверов (внутренние IP)
    server {{ hostvars['app1']['ansible_host'] }}:8080 max_fails=3 fail_timeout=30s;
    server {{ hostvars['app2']['ansible_host'] }}:8080 max_fails=3 fail_timeout=30s;
}

server {
    listen 80;
    server_name _;

    location / {
        proxy_pass http://backend_mediawiki;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Статика может кэшироваться
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
        proxy_pass http://backend_mediawiki;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}