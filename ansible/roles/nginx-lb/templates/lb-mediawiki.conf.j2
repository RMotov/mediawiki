upstream backend_mediawiki {
    # Список app серверов (внутренние IP)
    server {{ hostvars['app1']['internal_ip'] }}:8080 max_fails=3 fail_timeout=30s;
    server {{ hostvars['app2']['internal_ip'] }}:8080 max_fails=3 fail_timeout=30s;
    # Чтобы один пользователь всегда попадал на тот же сервер
    ip_hash;
}

server {
    listen 80 default_server;
    server_name _;

    location / {
        proxy_pass http://backend_mediawiki;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}